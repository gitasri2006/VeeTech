# =====================================================================
#                     DISCOVERY PLATFORM CONFIGURATION (TEMPLATE)
# =====================================================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# LLM & AI Models Configuration
# ---------------------------------------------------------------------
# LLM Provider Hierarchy (Primary: Mistral AI, Fallback: Google Gemini)
LLM_PRIMARY_PROVIDER=mistral
LLM_FALLBACK_PROVIDER=gemini

# Primary AI: Mistral AI Configuration
# Recommended Model: mistral-large-latest (Top reasoning, 128k context, deep multilingual & JSON structured synthesis)
# Fast alternative: mistral-small-latest
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# Fallback AI: Google Gemini Configuration (Automatic failover on rate limits / network errors)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.0

# Serper Google Search API (Real-Time Live Web & News Discovery)
SERPER_API_KEY=your_serper_api_key_here

# Playwright Headless Web Scraping Engine
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------
# Social & External Intelligence APIs
# ---------------------------------------------------------------------
# X (Twitter) API v2
X_BEARER_TOKEN=your_x_bearer_token_here
X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here

# Google Fact Check Tools API
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# YouTube Data API v3
YOUTUBE_API_KEY=your_youtube_api_key_here

# Telegram Bot API (Public Channels & Feeds)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_APP_ID=your_instagram_app_id_here
INSTAGRAM_APP_SECRET=your_instagram_app_secret_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here

# ---------------------------------------------------------------------
# Intelligence Ingestion Feeds (GDELT & News API)
# ---------------------------------------------------------------------
GDELT_API_URL=https://api.gdeltproject.org/api/v2/gkg/gkg
GDELT_DOC_API_URL=http://api.gdeltproject.org/api/v2/doc/doc
GDELT_ENABLED=true
GDELT_TIMESPAN=60min
GDELT_MAX_RECORDS=30
GDELT_DEFAULT_QUERY="(technology OR energy OR regulatory OR industry OR climate OR health OR business OR economy OR policy)"
NEWS_API_KEY=your_licensed_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# ---------------------------------------------------------------------
# Database & Vector Store (PostgreSQL 16 + pgvector)
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=discovery
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/discovery

# ---------------------------------------------------------------------
# Message Bus & Cache (Redis 7)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API (Agent 10 Webhook)
# ---------------------------------------------------------------------
META_VERIFY_TOKEN=discovery_meta_verify_token_2026
META_APP_SECRET=discovery_meta_app_secret_test
META_WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_PHONE_SALT=discovery_secure_phone_hash_salt_2026

# ---------------------------------------------------------------------
# Master Unified Backend Service (Consolidated Port 8000)
# ---------------------------------------------------------------------
PORT=8000
UNIFIED_PORT=8000
FRONTEND_PORT=3000

# ---------------------------------------------------------------------
# Frontend Client Configuration
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000

