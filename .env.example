# =====================================================================
#                     DISCOVERY PLATFORM CONFIGURATION (TEMPLATE)
# =====================================================================

# Environment Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------
# LLM & AI Models Configuration
# ---------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ---------------------------------------------------------------------
# Database & Vector Store (PostgreSQL 16 + pgvector)
# ---------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=discovery
POSTGRES_USER=discovery_user
POSTGRES_PASSWORD=discovery_secure_password_2026
DATABASE_URL=postgresql://discovery_user:discovery_secure_password_2026@localhost:5432/discovery

# ---------------------------------------------------------------------
# Message Bus & Cache (Redis 7)
# ---------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------
# Meta WhatsApp Cloud API (Agent 10 Webhook)
# ---------------------------------------------------------------------
META_VERIFY_TOKEN=discovery_meta_verify_token_2026
META_APP_SECRET=discovery_meta_app_secret_test
META_WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_PHONE_SALT=discovery_secure_phone_hash_salt_2026

# ---------------------------------------------------------------------
# Microservice Port Allocations
# ---------------------------------------------------------------------
EXTRACTION_SERVICE_PORT=8000
FILTERING_SERVICE_PORT=8001
ENTITY_PROFILE_SERVICE_PORT=8002
CONTEXTUAL_VALIDATION_SERVICE_PORT=8003
GLOBAL_DISCOVERY_SERVICE_PORT=8004
MULTILINGUAL_SERVICE_PORT=8005
FACT_CHECKING_SERVICE_PORT=8006
SOURCE_INTELLIGENCE_SERVICE_PORT=8007
WHATSAPP_BOT_SERVICE_PORT=8008
BRIEF_CLUSTERING_SERVICE_PORT=8009
FRONTEND_PORT=3000

# ---------------------------------------------------------------------
# Frontend Client Configuration
# ---------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost
